# =====================================================================
# TITAN - Personal AI Assistant Environment Configuration
# =====================================================================

# Application
PROJECT_NAME=TITAN
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=titan_super_secret_jwt_key_change_in_production_2026_x99!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with asyncpg)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
# For local dual testing/sqlite fallback: sqlite+aiosqlite:///./titan.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/titan
DATABASE_ECHO=False

# AI Orchestration (OpenAI API)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Voice Agent (LiveKit)
# Get free cloud instance credentials from: https://cloud.livekit.io/
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# External Information Providers
# Weather: WeatherAPI (https://www.weatherapi.com/) or Open-Meteo (Zero-key fallback included)
WEATHER_API_KEY=

# News: NewsAPI (https://newsapi.org/) or GNews (https://gnews.io/)
NEWS_API_KEY=

# Maps: Mapbox Token (https://www.mapbox.com/) - Optional, OpenStreetMap Leaflet tiles work out-of-the-box
MAPBOX_TOKEN=

# CORS Settings (Comma-separated list of allowed frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
